# ================================================================
# inCognitus — Environment Variables Template
# Copy this file to .env.local and fill in your Supabase project keys
# ================================================================

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Public API Key (Project Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
